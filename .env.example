# Environment Configuration for Personal Finance Advisor Bot
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars

# Database URL (SQLite default, PostgreSQL ready: postgresql://user:pass@localhost:5432/finance)
DATABASE_URL=sqlite:///finance.db

# AI Provider: 'mock' (offline/tests/no key) or 'gemini'
AI_PROVIDER=mock
GEMINI_API_KEY=

# Session Security
SESSION_COOKIE_SECURE=False
